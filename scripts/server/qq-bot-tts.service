[Unit]
Description=QQ Bot MOSS-TTS-Nano adapter
After=network.target

[Service]
Type=simple
WorkingDirectory=QQ_BOT_ROOT_PLACEHOLDER
Environment=QQ_BOT_TTS_REPO_DIR=QQ_BOT_TTS_REPO_DIR_PLACEHOLDER
Environment=QQ_BOT_TTS_MODEL_DIR=QQ_BOT_TTS_MODEL_DIR_PLACEHOLDER
Environment=QQ_BOT_TTS_OUTPUT_DIR=QQ_BOT_TTS_OUTPUT_DIR_PLACEHOLDER
Environment=QQ_BOT_TTS_EXECUTION_PROVIDER=QQ_BOT_TTS_EXECUTION_PROVIDER_PLACEHOLDER
Environment=QQ_BOT_CONFIG_PATH=QQ_BOT_ROOT_PLACEHOLDER/config/config.json
Environment=LD_LIBRARY_PATH=QQ_BOT_TTS_LD_LIBRARY_PATH_PLACEHOLDER
ExecStart=QQ_BOT_TTS_PYTHON_PLACEHOLDER QQ_BOT_ROOT_PLACEHOLDER/scripts/server/moss_tts_adapter.py --host 127.0.0.1 --port 18100 --config-path QQ_BOT_ROOT_PLACEHOLDER/config/config.json --repo-dir QQ_BOT_TTS_REPO_DIR_PLACEHOLDER --model-dir QQ_BOT_TTS_MODEL_DIR_PLACEHOLDER --output-dir QQ_BOT_TTS_OUTPUT_DIR_PLACEHOLDER --execution-provider QQ_BOT_TTS_EXECUTION_PROVIDER_PLACEHOLDER
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
